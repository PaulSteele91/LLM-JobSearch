# ==========================================
# API Keys
# ==========================================
# Tavily Search API Key (Required for live ATS scraping)
TAVILY_API_KEY=your_tavily_api_key_here

# Resend API Key (Optional: for HTML/plain text email alerts)
RESEND_API_KEY=your_resend_api_key_here
ENABLE_EMAIL_ALERTS=False
RECEIVER_EMAIL=your_email@example.com

# ==========================================
# Local File Paths
# ==========================================
RESUME_PATH=./sample_resume.pdf
OUTPUT_PATH=./matched_jobs.md
SEEN_JOBS_PATH=./seen_jobs.json

# ==========================================
# Filtering & Search Thresholds
# ==========================================
TARGET_MATCHES=5
SCORE_THRESHOLD=7.0
APPROVED_LOCATIONS="Remote-First / Distributed, Coastal California, Greater Denver (CO), New York City Metro, Massachusetts, or Florida"

# ==========================================
# Local Ollama Models (Tuned for 12GB VRAM GPU)
# ==========================================
MODEL_SOURCER=qwen2.5:14b
MODEL_ANALYST=phi4:14b
MODEL_AUDITOR=gemma4:12b
